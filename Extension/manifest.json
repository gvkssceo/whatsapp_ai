{
  "manifest_version": 3,
  "name": "Nax",
  "description": "Intelligent WhatsApp Web chat analysis with ML-powered message prioritization, summarization, and insights. Extract and analyze your conversations using local ML models.",
  "version": "2.0.1",
  "permissions": [
    "scripting", 
    "activeTab", 
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "https://web.whatsapp.com/*",
    "http://127.0.0.1:8000/*",
    "http://localhost:8000/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon.png",
      "32": "icon.png",
      "48": "icon.png",
      "128": "icon.png"
    },
    "default_title": "Nax - Message Prioritization & Analysis"
  },
  "content_scripts": [
    {
      "matches": ["https://web.whatsapp.com/*"],
      "js": ["ultra_error_suppressor.js", "whatsapp_error_handler.js", "content_chat_scanner.js", "content.js"],
      "run_at": "document_start",
      "all_frames": false
    }
  ],
  "icons": {
    "16": "icon.png",
    "32": "icon.png",
    "48": "icon.png",
    "128": "icon.png"
  },
  "web_accessible_resources": [
    {
      "resources": ["icon.png", "test_emoji.html", "test_enhanced_extraction.html", "nax.mp4", "test_chat_title.html", "test_chat_scanner.html", "data/messages.csv", "debug_fixes.js", "whatsapp_error_handler.js", "ultra_error_suppressor.js"],
      "matches": ["https://web.whatsapp.com/*"],
      "use_dynamic_url": true
    }
  ]
}
